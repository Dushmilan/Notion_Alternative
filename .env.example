# === Google Drive OAuth ===
# OAuth 2.0 Client ID from Google Cloud Console
# Required for Google Drive appDataFolder sync
VITE_GOOGLE_CLIENT_ID=

# OAuth 2.0 Client Secret (keep secret, server-side use only)
VITE_GOOGLE_CLIENT_SECRET=

# Google OAuth redirect URI
# For Tauri desktop: http://localhost:1420
# For Android: com.notion-alternative.dev:/oauthredirect
VITE_GOOGLE_REDIRECT_URI=

# === Tauri ===
# Tauri app window configuration
TAURI_WINDOW_TITLE=Notion_alternative.dev
TAURI_WINDOW_WIDTH=1200
TAURI_WINDOW_HEIGHT=800

# === Database ===
# Path for local SQLite database file (relative to app data dir)
# Default: notion-alternative.db
VITE_DB_FILENAME=

# === Sync ===
# Sync interval in milliseconds (how often to poll Google Drive for changes)
# Default: 30000 (30 seconds)
VITE_SYNC_POLL_INTERVAL=

# Yjs awareness heartbeat interval in ms
# Default: 30000
VITE_AWARENESS_HEARTBEAT_INTERVAL=

# === Logging ===
# Log level: debug | info | warn | error
VITE_LOG_LEVEL=info
